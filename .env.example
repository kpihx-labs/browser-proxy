# BROWSER_PROXY_IDLE_SECONDS: daemon inactivity limit; valid example: 1800
BROWSER_PROXY_IDLE_SECONDS=1800
# BROWSER_PROXY_MAX_LIFETIME_SECONDS: hard daemon lifetime; valid example: 28800
BROWSER_PROXY_MAX_LIFETIME_SECONDS=28800
# BROWSER_PROXY_EXTENSION_PORT: loopback extension bridge port; valid example: 9876
BROWSER_PROXY_EXTENSION_PORT=9876
